{
  "name": "space-analyser",
  "productName": "Space Analyser",
  "version": "0.1.0",
  "private": true,
  "description": "Find everything on your Mac and reclaim storage",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.12",
    "d3-hierarchy": "3.1.2",
    "d3-shape": "3.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  },
  "build": {
    "appId": "com.gryphin.space-analyser",
    "productName": "Space Analyser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "out/main/**"
    ],
    "extraResources": [
      {
        "from": "../scanner/.build/release/sa-scan",
        "to": "bin/sa-scan"
      }
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.utilities",
      "identity": null
    }
  }
}
